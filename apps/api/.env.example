PORT=4000
NODE_ENV=development

DB_HOST=localhost
DB_PORT=3307
DB_USERNAME=pharmacy_user
DB_PASSWORD=change-me
DB_DATABASE=pharmacy_db

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change-me
REDIS_DB=0

MINIO_HOST=localhost
MINIO_PORT=9000

# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
AUDIT_HMAC_SECRET=

ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800

# Comma-separated list of allowed browser origins (credentials are enabled)
CORS_ORIGIN=http://localhost:3000
# Defaults to true in production, false otherwise
# COOKIE_SECURE=true
# Set to true only when running behind a trusted reverse proxy
TRUST_PROXY=false

# Seed: initial administrator (password is generated and printed once if omitted)
ADMIN_EMAIL=admin@pharmacy.system
# ADMIN_INITIAL_PASSWORD=
